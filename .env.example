# Supabase Authentication (required for Sprint 1)
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Sheets Integration (for lead data sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id

# Twilio SMS (required for Missed Call Recovery + Estimate Follow-up modules)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
OWNER_ALERT_PHONE=+1234567890

# Cron authentication (required for the Estimate Follow-up scheduled scan)
# Vercel Cron sends this as "Authorization: Bearer $CRON_SECRET" automatically
# once set as a project env var — see vercel.json
CRON_SECRET=generate-a-long-random-secret

# Resend email (required for Missed Call Recovery owner email notifications)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=alerts@your-verified-sender.com

# Public app URL (used to build lead links in SMS/email notifications)
# Defaults to https://ai-backoffice-v1.vercel.app if unset
NEXT_PUBLIC_APP_URL=https://ai-backoffice-v1.vercel.app

# Legacy (deprecated - kept for reference)
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_RANGE=Sheet1!A:T
# GOOGLE_SHEETS_API_KEY=
