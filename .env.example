# Supabase Authentication (required for Sprint 1)
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Sheets Integration (legacy read-only bootstrap; NOT the canonical intake path)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id

# Twilio SMS (required for Missed Call Recovery + Estimate Follow-up modules)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
OWNER_ALERT_PHONE=+1234567890

# Cron authentication (required for the Estimate Follow-up scheduled scan)
# Vercel Cron sends this as "Authorization: Bearer $CRON_SECRET" automatically
# once set as a project env var — see vercel.json
CRON_SECRET=generate-a-long-random-secret

# Resend email (Missed Call Recovery and canonical intake owner notifications)
RESEND_API_KEY=your-resend-api-key
EMAIL_FROM=noreply@aibackoffice.app

# Public app URL (used to build lead links in SMS/email notifications)
# Defaults to https://aibackoffice.app if unset
NEXT_PUBLIC_APP_URL=https://aibackoffice.app

# Model Gateway (P0 Agentic Foundation — see MODEL_GATEWAY.md). Optional:
# when unset, the gateway falls back to a deterministic mock provider, so
# dev/CI/tests never require this.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Legacy (deprecated - kept for reference)
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_RANGE=Sheet1!A:T
# GOOGLE_SHEETS_API_KEY=

# Canonical intake reuses Supabase credentials above and tenants.slug (active tenants).
# Owner notification recipient is tenants.email, configured by the operator.
# No new environment variable is required for Intake v2.
