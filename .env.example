# Supabase Authentication (required for Sprint 1)
# Get these from your Supabase project settings: https://app.supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Sheets Integration (for lead data sync)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYour private key here\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEET_ID=your-google-sheet-id

# Twilio SMS (for future use - not required for Sprint 1)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
# OWNER_PHONE_NUMBER=+1234567890

# Legacy (deprecated - kept for reference)
# GOOGLE_SHEETS_SPREADSHEET_ID=
# GOOGLE_SHEETS_RANGE=Sheet1!A:T
# GOOGLE_SHEETS_API_KEY=
